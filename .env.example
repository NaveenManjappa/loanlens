# Copy to .env and fill in. Never commit .env.
# From your Microsoft Foundry resource (Azure OpenAI v1 API — no api-version needed)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=<api-key>
# The name YOU gave the model deployment in Foundry (not the model name)
AZURE_OPENAI_DEPLOYMENT_NAME=<your-deployment-name>

# ── Optional: LangSmith tracing ─────────────────────────────────────────────
# Create an API key at smith.langchain.com -> Settings -> API Keys
# Set to true once you've added a key (comments on their own line: docker --env-file
# doesn't strip inline comments)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=<langsmith-api-key>
# Project-based workspace: traces go to this project
LANGSMITH_PROJECT=loanlens
# Agent-based workspace: use these two INSTEAD of LANGSMITH_PROJECT
# LANGSMITH_AGENT_ID=<agent-id>
# LANGSMITH_AGENT_ENVIRONMENT=<environment>
# Keep model inputs (customer data) out of traces
LANGSMITH_HIDE_INPUTS=true
# Only if your LangSmith account is in the EU region
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# ── Optional: Postgres instead of the local SQLite file ─────────────────────
# e.g. your Neon connection string; leave unset to use loanlens_cases.db
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
